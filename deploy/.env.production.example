# Copy thành deploy/.env rồi điền. File này KHÔNG commit.

# --- Domain (DNS A record của cả 3 trỏ về IP VPS) ---
CRM_DOMAIN=crm.zero1.edu.vn
LMS_DOMAIN=lms.zero1.edu.vn
API_DOMAIN=api.zero1.edu.vn
# Email nhận thông báo chứng chỉ Let's Encrypt
ACME_EMAIL=it@zero1.edu.vn
# Domain cha để 2 app dùng chung phiên đăng nhập (có dấu chấm đầu)
COOKIE_DOMAIN=.zero1.edu.vn

# --- Database (tên DB phải bắt đầu bằng zero1_ — xem mariadb/01-grants.sh) ---
MARIADB_ROOT_PASSWORD=
DB_USER=zero1
DB_PASSWORD=
DB_NAME_CORE=zero1_core
DB_NAME_CRM=zero1_crm
DB_NAME_LMS=zero1_lms

# --- Bảo mật ---
# Tối thiểu 32 ký tự. Sinh: openssl rand -base64 48
JWT_ACCESS_SECRET=
LOG_LEVEL=info

# --- Email (đặt lại mật khẩu…) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zero1 <no-reply@zero1.edu.vn>

# --- Lưu file: để trống → lưu trong volume `uploads` của server ---
CLOUDINARY_URL=

# --- Telegram nội bộ (token từ @BotFather). Bỏ trống → không gửi ---
TELEGRAM_BOT_TOKEN=

# --- Tài khoản ADMIN đầu tiên (docker compose exec api node dist/cli/seed.js) ---
SEED_ADMIN_EMAIL=admin@zero1.edu.vn
SEED_ADMIN_PASSWORD=

# --- Sao lưu DB (deploy/backups) ---
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
