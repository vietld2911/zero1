{
  "name": "@zero1/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.core.config.ts && drizzle-kit generate --config drizzle.crm.config.ts && drizzle-kit generate --config drizzle.lms.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "db:reconcile": "tsx --env-file-if-exists=.env scripts/reconcile.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@scalar/express-api-reference": "^0.10.27",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.9.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.16",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@zero1/config": "*",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
