{
  "name": "zero1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "npm run dev -w @zero1/api",
    "dev:crm": "npm run dev -w @zero1/crm-web",
    "dev:lms": "npm run dev -w @zero1/lms-web",
    "db:migrate": "npm run db:migrate -w @zero1/api",
    "api-client:generate": "npm run openapi:export -w @zero1/api && npm run generate -w @zero1/api-client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:seed": "npm run db:seed -w @zero1/api",
    "db:seed-demo": "npm run db:seed-demo -w @zero1/api --",
    "db:reconcile": "npm run db:reconcile -w @zero1/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
