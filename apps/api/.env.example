NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Mỗi context một database (docs/architecture.md §3). Có thể dùng chung user/host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME_CORE=zero1_core
DB_NAME_CRM=zero1_crm
DB_NAME_LMS=zero1_lms

# Tối thiểu 32 ký tự. Sinh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Origin của 2 web app, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# true khi chạy sau nginx / reverse proxy
TRUST_PROXY=false
# Domain cha của 2 app ở production, ví dụ .zero1.edu.vn (để trống khi dev)
COOKIE_DOMAIN=

CRM_WEB_URL=http://localhost:5173
LMS_WEB_URL=http://localhost:5174

# Email. Để trống SMTP_HOST khi dev: email được in ra log thay vì gửi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zero1 <no-reply@zero1.local>

# Telegram nội bộ: tạo bot qua @BotFather, dán token; thêm bot vào nhóm của từng chi nhánh
# rồi cấu hình nhóm ở CRM/LMS → Cài đặt → Tích hợp. Bỏ trống → không gửi Telegram.
TELEGRAM_BOT_TOKEN=
# Cho webhook gửi tới địa chỉ nội bộ (localhost, 192.168.x…). Mặc định: bật khi dev, tắt khi production.
WEBHOOK_ALLOW_PRIVATE=

# Lưu file: để trống CLOUDINARY_URL → lưu trên đĩa trong UPLOAD_DIR
UPLOAD_DIR=uploads
CLOUDINARY_URL=

# Tài khoản ADMIN đầu tiên (npm run db:seed). Bỏ trống mật khẩu → tự sinh và in ra một lần.
SEED_ADMIN_EMAIL=admin@zero1.local
SEED_ADMIN_PASSWORD=
